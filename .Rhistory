round(iqr_conv_rice_local, 2), "), ",
round(min_conv_rice_local, 2), "-",
round(max_conv_rice_local, 2))
) %>%
select(country, count_org_rice_vendors, count_conv_rice_vendors,
org_price_local, conv_price_local)
# Calculate overall number of organic and conventional vendors, median, IQR, min and max price
tab_S8_overall_data_local <- rice_prices_data %>%
summarise(
count_org_rice_vendors = sum(!is.na(rice_price_org_kg)),
count_conv_rice_vendors = sum(!is.na(rice_price_conv_kg)),
median_org_rice_local = median(rice_price_org_kg, na.rm = TRUE),
iqr_org_rice_local = IQR(rice_price_org_kg, na.rm = TRUE),
min_org_rice_local = min(rice_price_org_kg, na.rm = TRUE),
max_org_rice_local = max(rice_price_org_kg, na.rm = TRUE),
median_conv_rice_local = median(rice_price_conv_kg, na.rm = TRUE),
iqr_conv_rice_local = IQR(rice_price_conv_kg, na.rm = TRUE),
min_conv_rice_local = min(rice_price_conv_kg, na.rm = TRUE),
max_conv_rice_local = max(rice_price_conv_kg, na.rm = TRUE),
) %>%
mutate(
org_price_local = paste0(round(median_org_rice_local, 2), " (",
round(iqr_org_rice_local, 2), "), ",
round(min_org_rice_local, 2), "-",
round(max_org_rice_local, 2)),
conv_price_local = paste0(round(median_conv_rice_local, 2), " (",
round(iqr_conv_rice_local, 2), "), ",
round(min_conv_rice_local, 2), "-",
round(max_conv_rice_local, 2))
) %>%
select(count_org_rice_vendors, count_conv_rice_vendors,
org_price_local, conv_price_local)
# Combine tables
combined_tab_S8_local <- bind_rows(
tab_S8_neighbourhood_data_local %>%
mutate(level = "Neighbourhood"),
tab_S8_city_data_local %>%
mutate(level = "City"),
tab_S8_country_data_local %>%
mutate(level = "Country"),
tab_S8_overall_data_local %>%
mutate(level = "Overall")
)
# Create a custom order for the 'level' column to ensure Neighbourhood rows come first, then City, and then Country
combined_tab_S8_local$level <- factor(combined_tab_S8_local$level,
levels = c("Neighbourhood", "City", "Country", "Overall"))
# Sort the combined data by country, city, and the custom level order
tab_S8_final_local <- combined_tab_S8_local %>%
arrange(country, city, level)
# Export to table_outputs workbook
addWorksheet(table_outputs, "Table S8 - USD")
writeData(table_outputs, sheet = "Table S8 - USD", x = tab_S8_final)
# Export to table_outputs workbook
addWorksheet(table_outputs, "Table S8 - local")
writeData(table_outputs, sheet = "Table S8 - local", x = tab_S8_final_local)
saveWorkbook(table_outputs, "Outputs/table_outputs.xlsx", overwrite = TRUE)
