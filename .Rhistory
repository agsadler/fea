# Combine tables
combined_tab_S8 <- bind_rows(
tab_S8_neighbourhood_data %>%
mutate(level = "Neighbourhood"),
tab_S8_city_data %>%
mutate(level = "City"),
tab_S8_country_data %>%
mutate(level = "Country"),
tab_S8_overall_data %>%
mutate(level = "Overall")
)
# Create a custom order for the 'level' column to ensure Neighbourhood rows come first, then City, and then Country
combined_tab_S8$level <- factor(combined_tab_S8$level,
levels = c("Neighbourhood", "City", "Country", "Overall"))
# Sort the combined data by country, city, and the custom level order
tab_S8_final <- combined_tab_S8 %>%
arrange(country, city, level)
